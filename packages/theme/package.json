{
  "name": "@superdreams/theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Super Dreams design system — Tailwind preset and design-token CSS.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./preset": {
      "types": "./src/preset.ts",
      "default": "./src/preset.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf coverage .turbo"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.0.5"
  }
}
