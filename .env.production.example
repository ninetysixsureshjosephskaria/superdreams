# Super Dreams Platform — PRODUCTION environment template.
#
# Copy to `.env.production` (git-ignored) and set strong, unique secrets.
# NEVER commit real production secrets. Prefer a real secrets manager
# (Docker/Swarm secrets, Vault, cloud secret store) over plain env files.

NODE_ENV=production

# Host ports (adjust to your ingress topology)
API_PORT=3000
BCC_PORT=8080
MEMBER_PORT=8081
EDGE_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database — use a managed instance / strong credentials in production
POSTGRES_USER=superdreams
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_PASSWORD__
POSTGRES_DB=superdreams

# Cache
REDIS_PASSWORD=__CHANGE_ME_STRONG_PASSWORD__

# API
LOG_LEVEL=info
CORS_ORIGINS=https://app.example.com,https://members.example.com
SWAGGER_ENABLED=false
JWT_SECRET=__CHANGE_ME_AT_LEAST_32_RANDOM_CHARS__

# Frontend (baked into the build — set to the public API origin)
VITE_API_BASE_URL=https://api.example.com
BCC_APP_NAME=Super Dreams — Business Control Center
MEMBER_APP_NAME=Super Dreams — Member Portal
