# Super Dreams — API Service Environment (Example)
#
# Copy to `.env` and adjust for your environment. Never commit a real `.env`.
# All variables are validated on startup with Zod; invalid values abort boot.

# --- Application ---
# Runtime environment: development | test | staging | production
NODE_ENV=development
# Host/port the HTTP server binds to.
HOST=0.0.0.0
PORT=3000

# --- Logging ---
# Pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/superdreams
DATABASE_POOL_MAX=10

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379

# --- JWT (configuration only; authentication is not implemented in this phase) ---
# In production a strong, unique secret is REQUIRED (startup fails otherwise).
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for any (development only).
CORS_ORIGINS=*

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# --- API documentation (Swagger) ---
# When unset: enabled outside production, DISABLED in production.
# Set explicitly to override (e.g. SWAGGER_ENABLED=true to enable in production).
# SWAGGER_ENABLED=true
