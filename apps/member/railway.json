{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile --prod=false --config.confirmModulesPurge=false && pnpm --filter @superdreams/member build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @superdreams/member start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
