# Super Dreams — Business Control Center (environment example)
#
# Copy to `.env` (or `.env.local`) and adjust. Vite only exposes variables
# prefixed with VITE_ to the client. Values are validated on startup.

# Base URL of the Super Dreams API service.
VITE_API_BASE_URL=http://localhost:3000

# Display name for the application.
VITE_APP_NAME=Super Dreams — Business Control Center
