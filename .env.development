# Super Dreams Platform — Local development defaults (safe to commit).
#
# Used by Docker Compose for local development:
#   docker compose -f docker-compose.dev.yml --env-file .env.development up -d
#   docker compose --env-file .env.development up --build   # full stack
#
# These are LOCAL, non-sensitive defaults only. Never reuse in staging/production.

NODE_ENV=development

# Host ports
API_PORT=3000
BCC_PORT=8080
MEMBER_PORT=8081
EDGE_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8090

# Database
POSTGRES_USER=superdreams
POSTGRES_PASSWORD=superdreams
POSTGRES_DB=superdreams

# Cache
REDIS_PASSWORD=superdreams

# API
LOG_LEVEL=debug
CORS_ORIGINS=*
SWAGGER_ENABLED=true
JWT_SECRET=dev-only-not-a-secret-change-in-production

# Frontend
VITE_API_BASE_URL=http://localhost:3000
BCC_APP_NAME=Super Dreams — Business Control Center
MEMBER_APP_NAME=Super Dreams — Member Portal
