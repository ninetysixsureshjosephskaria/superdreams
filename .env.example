# Super Dreams Platform — Environment Variables (Example)
#
# Copy this file to `.env` and adjust values. Never commit a real `.env`.
# Ready-made templates:
#   - .env.development           safe local defaults (committed)
#   - .env.production.example    production template (copy to .env.production)
#
# Docker Compose reads these via `--env-file`. Vite bakes VITE_-prefixed
# variables into the frontend bundles at build time.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Host ports ─────────────────────────────────────────────────────────────
API_PORT=3000
BCC_PORT=8080
MEMBER_PORT=8081
EDGE_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8090

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
POSTGRES_USER=superdreams
POSTGRES_PASSWORD=change-me
POSTGRES_DB=superdreams

# ── Cache (Redis) ──────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ── API service ────────────────────────────────────────────────────────────
LOG_LEVEL=info
CORS_ORIGINS=*
SWAGGER_ENABLED=false
# Strong, unique value required in staging/production (>= 16 characters).
JWT_SECRET=change-me-in-production

# ── Frontend (baked into the build; VITE_-prefixed only) ───────────────────
VITE_API_BASE_URL=http://localhost:3000
BCC_APP_NAME=Super Dreams — Business Control Center
MEMBER_APP_NAME=Super Dreams — Member Portal
